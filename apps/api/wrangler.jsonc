{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forgebridge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ORIGIN": "http://localhost:5173" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgebridge-db",
      "database_id": "eeafdf4e-7d5d-4ea2-8d1c-7984b749ecf3",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // D1 ID supplied by the owner. Add the optional DOCUMENTS R2 binding only after its dedicated bucket exists.
  // No public route is configured. See DEPLOYMENT.md before publishing.
}
