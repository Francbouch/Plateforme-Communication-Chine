{
  "name": "forgebridge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
}
