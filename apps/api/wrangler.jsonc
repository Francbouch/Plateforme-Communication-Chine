{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forgebridge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  // Preserve dashboard-managed Access/admin variables across Git deployments.
  "keep_vars": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://forgebridge-api.francbouch.workers.dev",
    "VERCEL_ORIGIN": "https://plateforme-communication-chine.vercel.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgebridge-db",
      "database_id": "eeafdf4e-7d5d-4ea2-8d1c-7984b749ecf3",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "forgebridge-documents" },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Create the dedicated private forgebridge-documents bucket before deploying phase 2.
  // workers.dev is enabled behind the existing All traffic Cloudflare Access policy.
  // ACCESS_*, ADMIN_* remain dashboard-managed; ORIGIN_SHARED_SECRET stays a secret.
  // For local development override APP_ORIGIN via apps/api/.dev.vars.
}
