{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forgebridge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ORIGIN": "http://localhost:5173" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgebridge-db",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "forgebridge-documents" },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // No remote database ID or route is invented. See DEPLOYMENT.md before publishing.
}
