# Frontend: apps/web/.env.local — public values only
VITE_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Worker: apps/api/.dev.vars — never commit
SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
APP_ORIGIN=http://localhost:5173
# Provisioning only; never expose or use a service-role key in the frontend/API.
