# Worker only: copy to apps/api/.dev.vars, then enter real configuration securely.
# The Worker refuses all requests if Access/administrator configuration is absent.
# ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
# ACCESS_AUD=APPLICATION_AUDIENCE_FROM_ACCESS
# ADMIN_EMAIL=YOUR_EXACT_ALLOWED_EMAIL
# ADMIN_USER_ID=GENERATE_ONCE_WITH_CRYPTO_RANDOMUUID
ADMIN_NAME=ForgeBridge
APP_ORIGIN=http://localhost:5173
# VERCEL_ORIGIN=https://YOUR_CANONICAL_PROJECT.vercel.app
# ORIGIN_SHARED_SECRET=GENERATE_32_RANDOM_BYTES_BASE64URL
# Vercel server-side environment: the same ORIGIN_SHARED_SECRET (never VITE_*).
# The React frontend uses same-origin /api. It needs NO secrets or identity variables.
