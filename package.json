{
  "name": "forgebridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k 'npm run dev -w @forgebridge/api' 'npm run dev -w @forgebridge/web'",
    "build": "npm run build -w @forgebridge/web && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run tests/d1-api.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "db:migrate": "npm run db:migrate -w @forgebridge/api",
    "build:worker": "npm run build -w @forgebridge/api",
    "test:private": "playwright test --config playwright.private.config.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:worker && npm run test:preview && npm run test:private"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "miniflare": "^5.20261023.2-beta",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5"
  }
}
