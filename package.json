{
  "name": "forgebridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k 'npm run dev -w @forgebridge/api' 'npm run dev -w @forgebridge/web'",
    "build": "npm run build -w @forgebridge/web && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "supabase:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop",
    "test:preview": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  }
}
